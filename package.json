{
  "name": "krunked-cells",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Krunked Cells — WebGL2 normal-mapped roguelite action-platformer built for the Krunked Foundry.",
  "scripts": {
    "extract": "tsx tools/extract-assets.ts",
    "oracle": "tsx tools/oracle-dump.ts",
    "dev": "vite",
    "play": "vite --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:assets": "tsx scripts/verify/verify-assets.ts",
    "verify:sim": "tsx scripts/verify/verify-sim.ts",
    "verify": "npm run typecheck && npm run verify:assets && npm run test && npm run verify:sim",
    "build": "vite build",
    "export:dna": "tsx scripts/verify/export-dna.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
